---
interface Props {
  photos: string[];
  alt?: string;
}

const { photos, alt = 'Motorsport photograph' } = Astro.props;
---

<div class="gallery" data-gallery>
  {photos.map((src, i) => (
    <figure class="item" data-src={src} data-reveal style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}>
      <img src={src} alt={`${alt} ${i + 1}`} loading="lazy" />
    </figure>
  ))}
</div>

<div class="lightbox" data-lightbox hidden>
  <button class="lb-btn lb-close" type="button" aria-label="Close" data-lb-close>&times;</button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous" data-lb-prev>&lsaquo;</button>
  <img class="lb-img" data-lb-img alt="" />
  <button class="lb-btn lb-next" type="button" aria-label="Next" data-lb-next>&rsaquo;</button>
</div>

<script>
  const gallery = document.querySelector('[data-gallery]');
  const lightbox = document.querySelector('[data-lightbox]');

  if (gallery && lightbox) {
    const items = [...gallery.querySelectorAll('[data-src]')];
    const img = lightbox.querySelector('[data-lb-img]');
    const close = lightbox.querySelector('[data-lb-close]');
    const prev = lightbox.querySelector('[data-lb-prev]');
    const next = lightbox.querySelector('[data-lb-next]');
    let index = 0;

    const show = (i) => {
      index = (i + items.length) % items.length;
      img.src = items[index].dataset.src ?? '';
      img.alt = items[index].querySelector('img')?.alt ?? '';
    };
    const open = (i) => {
      show(i);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const closeLb = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };

    items.forEach((item, i) => item.addEventListener('click', () => open(i)));
    close?.addEventListener('click', closeLb);
    prev?.addEventListener('click', (e) => { e.stopPropagation(); show(index - 1); });
    next?.addEventListener('click', (e) => { e.stopPropagation(); show(index + 1); });
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLb(); });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  }
</script>

<style>
  .gallery {
    columns: 3 280px;
    column-gap: 1rem;
  }

  .gallery .item {
    margin: 0 0 1rem;
    break-inside: avoid;
    cursor: zoom-in;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
    transition: box-shadow 0.3s ease;
  }

  .gallery .item:hover {
    box-shadow: 0 14px 34px -14px rgba(225, 6, 0, 0.45);
  }

  .gallery img {
    width: 100%;
    height: auto;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .gallery .item:hover img {
    transform: scale(1.04);
    opacity: 0.9;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(4, 4, 6, 0.94);
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox:not([hidden]) {
    animation: lb-fade 0.22s ease both;
  }

  .lightbox:not([hidden]) .lb-img {
    animation: lb-zoom 0.3s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes lb-zoom {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .lb-img {
    max-width: 100%;
    max-height: 88vh;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .lb-btn {
    position: absolute;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    padding: 0.75rem;
    opacity: 0.75;
    transition: opacity 0.15s, color 0.15s;
  }

  .lb-btn:hover {
    opacity: 1;
    color: var(--accent);
  }

  .lb-close {
    top: 0.5rem;
    right: 0.75rem;
    font-size: 2.6rem;
  }

  .lb-prev {
    left: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next {
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 720px) {
    .gallery {
      columns: 2 150px;
      column-gap: 0.6rem;
    }
    .gallery .item {
      margin-bottom: 0.6rem;
    }
  }
</style>
