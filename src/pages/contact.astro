---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
---

<Layout title={`Contact — ${SITE.name}`} description={`Get in touch with ${SITE.photographer} for motorsport photography.`}>
  <section class="section">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">Contact</p>
        <h1>Let's work together</h1>
        <p class="lead">
          Event coverage, team commissions or editorial — tell me what you're planning and I'll get back to you.
        </p>
      </div>

      <div class="contact-grid">
        <div class="cta" data-reveal>
          <p>
            The quickest way to reach me is email. Include the event, dates and roughly what you need,
            and I'll reply within a couple of days.
          </p>
          <a class="btn" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Project enquiry')}`}>Send an email</a>
        </div>

        <aside class="direct" data-reveal style="--reveal-delay:100ms">
          <h3>Direct</h3>
          <ul>
            <li>
              <span class="k">Email</span>
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </li>
            <li>
              <span class="k">Instagram</span>
              <a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramHandle}</a>
            </li>
            <li>
              <span class="k">Base</span>
              <span>{SITE.location}</span>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .cta p {
    margin: 0;
    color: var(--muted);
    max-width: 44ch;
  }

  .direct {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.5rem;
  }

  .direct h3 {
    font-size: 1.1rem;
  }

  .direct ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .direct li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .direct .k {
    font-family: var(--font-head);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: var(--accent);
  }

  .direct a {
    color: var(--muted);
  }

  .direct a:hover {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
