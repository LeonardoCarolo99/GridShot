---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
---

<Layout title={`About — ${SITE.name}`} description={`About ${SITE.photographer}, ${SITE.tagline.toLowerCase()}.`}>
  <section class="section">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">About me</p>
        <h1>{SITE.photographer}</h1>
        <p class="lead">{SITE.tagline} — {SITE.location}</p>
      </div>

      <div class="about-grid">
        <div class="bio" data-reveal>
          <p>
            I've always been fascinated by cars and racing. A year ago, I decided to combine my passion for motorsport with my love for photography. Since then, I've been capturing the thrill and excitement of racing events, from the roar of engines to the intensity of competition.
            I've travelled across the country to cover various events, and each experience has been a unique adventure. My goal is 
            to capture the essence of racing and share it with the world.
          </p>
          <p>
            I am still learning and growing as a motorsport photographer, but I am committed to improving my skills and delivering high-quality images that tell the story of each event.
          </p>
        </div>

        <aside class="facts">
          <div class="fact" data-reveal style="--reveal-delay:80ms">
            <span class="fact-num">14</span>
            <span class="fact-label">months shooting motorsport</span>
          </div>
          <div class="fact" data-reveal style="--reveal-delay:160ms">
            <span class="fact-num">12</span>
            <span class="fact-label">Events covered</span>
          </div>
          <div class="fact" data-reveal style="--reveal-delay:240ms">
            <span class="fact-num">2400+</span>
            <span class="fact-label">Photos delivered</span>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .bio p {
    color: var(--muted);
    font-size: 1.05rem;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .fact {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .fact-num {
    font-family: var(--font-head);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .fact-label {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.35rem;
  }

  @media (max-width: 720px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
